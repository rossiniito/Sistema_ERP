function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return respostaJSON({ text: "Servidor online, aguardando dados." });
    }

    var event = JSON.parse(e.postData.contents);

    if (event.type === "CARD_CLICKED") {
      return processarCliqueBotao(event);
    }

    if (event.type === "MESSAGE") {
      var textoMensagem = event.message.text ? event.message.text.trim() : "";
      var temAnexo = event.message.attachment && event.message.attachment.length > 0;

      if (temAnexo) {
        return processarRecibo(event, textoMensagem);
      }

      if (textoMensagem.toLowerCase().indexOf("orcamento") !== -1 ||
          textoMensagem.toLowerCase().indexOf("orçamento") !== -1) {
        return calcularOrcamento(textoMensagem);
      }

      return respostaJSON({
        text: "AIOS V2 Online\n\nEnvie a foto do comprovante com a legenda informando o cliente ou obra.\nDigite 'orcamento [valor]' para calcular margem."
      });
    }

    return respostaJSON({ text: "Conexao estabelecida." });

  } catch (error) {
    return respostaJSON({ text: "Erro Fatal: " + error.message });
  }
}

function respostaJSON(objeto) {
  return ContentService
    .createTextOutput(JSON.stringify(objeto))
    .setMimeType(ContentService.MimeType.JSON);
}

function processarRecibo(event, legendaMensagem) {
  var anexo        = event.message.attachment[0];
  var attachmentId = anexo.attachmentDataRef.resourceName;

  try {
    // Download da imagem
    var urlChat = "https://chat.googleapis.com/v1/media/" + attachmentId + "?alt=media";
    var responseMedia = UrlFetchApp.fetch(urlChat, {
      method: "get",
      headers: { "Authorization": "Bearer " + ScriptApp.getOAuthToken() },
      muteHttpExceptions: true
    });

    if (responseMedia.getResponseCode() !== 200) {
      return respostaJSON({ text: "Falha ao baixar imagem do Chat. Codigo: " + responseMedia.getResponseCode() });
    }

    // Salva imagem na pasta do Drive
    var nomeArquivo = "Comprovante_" + Utilities.formatDate(new Date(), "GMT-3", "yyyyMMdd_HHmmss") + ".jpg";
    var pasta       = DriveApp.getFolderById(ID_PASTA_DRIVE);
    var arquivo     = pasta.createFile(responseMedia.getBlob().setName(nomeArquivo));
    arquivo.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var linkComprovante = arquivo.getUrl();

    var base64Image = Utilities.base64Encode(responseMedia.getBlob().getBytes());

    var urlGemini = "https://generativelanguage.googleapis.com/v1beta/models/" +
                    GEMINI_MODEL + ":generateContent?key=" + GEMINI_API_KEY;

    var prompt = "Analise este comprovante de pagamento e extraia as informacoes." +
      " Retorne APENAS um objeto JSON valido, sem markdown, sem explicacao:" +
      ' {"data": "DD/MM/YYYY", "fornecedor": "nome do estabelecimento", "valor": 0.00, "forma_pagamento": "Cartao, Pix, Boleto, Dinheiro, etc."}' +
      " Se algum campo nao estiver visivel, use string vazia ou 0.";

    var payload = {
      contents: [{
        parts: [
          { text: prompt },
          { inline_data: { mime_type: "image/jpeg", data: base64Image } }
        ]
      }]
    };

    // Chamada ao Gemini com retry automático
    var responseIA;
    var tentativas    = 0;
    var maxTentativas = 3;

    while (tentativas < maxTentativas) {
      tentativas++;
      responseIA = UrlFetchApp.fetch(urlGemini, {
        method: "post",
        contentType: "application/json",
        payload: JSON.stringify(payload),
        muteHttpExceptions: true
      });

      if (responseIA.getResponseCode() === 200) break;

      var codigoErro = JSON.parse(responseIA.getContentText()).error.code;
      if (codigoErro === 503 && tentativas < maxTentativas) {
        Utilities.sleep(3000);
      } else {
        return respostaJSON({
          text: "Erro na API Gemini (tentativa " + tentativas + "): " + responseIA.getContentText()
        });
      }
    }

    var dadosIA    = JSON.parse(responseIA.getContentText());
    var textoLimpo = dadosIA.candidates[0].content.parts[0].text.replace(/```json|```/gi, "").trim();
    var extraido   = JSON.parse(textoLimpo);

    extraido.centro_de_custo  = legendaMensagem || "";
    extraido.link_comprovante = linkComprovante;

    return respostaJSON(criarCardAprovacao(extraido));

  } catch (err) {
    return respostaJSON({ text: "Falha no processamento: " + err.message });
  }
}

