  var itensForma = opcoesForma.map(function(opcao) {
    return {
      text: opcao,
      value: opcao,
      selected: dados.forma_pagamento &&
                dados.forma_pagamento.toLowerCase().indexOf(opcao.toLowerCase()) !== -1
    };
  });

  return {
    text: "Comprovante lido. Revise os dados e confirme.",
    cardsV2: [{
      cardId: "card_recibo",
      card: {
        header: {
          title: "Despesa de Campo",
          subtitle: "Edite os campos e injete no MVP"
        },
        sections: [{
          widgets: [
            {
              textInput: {
                name: "fornecedor",
                label: "Fornecedor",
                type: "SINGLE_LINE",
                value: dados.fornecedor || ""
              }
            },
            {
              textInput: {
                name: "valor",
                label: "Valor (R$)",
                type: "SINGLE_LINE",
                value: String(dados.valor || "")
              }
            },
            {
              textInput: {
                name: "data",
                label: "Data (DD/MM/YYYY)",
                type: "SINGLE_LINE",
                value: dados.data || ""
              }
            },
            {
              textInput: {
                name: "centro_de_custo",
                label: "Cliente / Obra / Centro de Custo",
                type: "SINGLE_LINE",
                hintText: "Ex: Cliente Tanae, Obra Alphaville, G4 Treinamento",
                value: dados.centro_de_custo || ""
              }
            },
            {
              selectionInput: {
                name: "forma_pagamento",
                label: "Forma de Pagamento",
                type: "DROPDOWN",
                items: itensForma
              }
            },
            {
              textInput: {
                name: "link_comprovante",
                label: "Link do Comprovante (Drive)",
                type: "SINGLE_LINE",
                value: dados.link_comprovante || "URL_Pendente"
              }
            },
            {
              buttonList: {
                buttons: [{
                  text: "INJETAR NO MVP",
                  onClick: {
                    action: { function: "salvarMVP" }
                  }
                }]
              }
            }
          ]
        }]
      }
    }]
  };
}

function processarCliqueBotao(event) {
  if (event.action.actionMethodName === "salvarMVP") {
    try {
      var form = event.common.formInputs;

      var fornecedor      = (form.fornecedor && form.fornecedor.stringInputs.value[0])               || "N/A";
      var valorStr        = (form.valor && form.valor.stringInputs.value[0])                          || "0";
      var valor           = parseFloat(valorStr.replace(",", ".")) || 0;
      var data            = (form.data && form.data.stringInputs.value[0])                            || "N/A";
      var centroCusto     = (form.centro_de_custo && form.centro_de_custo.stringInputs.value[0])     || "A Classificar";
      var formaPgto       = (form.forma_pagamento && form.forma_pagamento.stringInputs.value[0])     || "Nao informado";
      var linkComprovante = (form.link_comprovante && form.link_comprovante.stringInputs.value[0])   || "URL_Pendente";

      var sheet = SpreadsheetApp.openById(ID_PLANILHA_MVP).getSheetByName(NOME_ABA);
      if (!sheet) throw new Error("Aba " + NOME_ABA + " nao encontrada.");

      sheet.appendRow([
        Utilities.getUuid(),
        data,
        "Contas a Pagar",
        fornecedor,
        valor,
        formaPgto,
        centroCusto,
        "Despesa Chat - " + fornecedor,
        linkComprovante,
        "Pendente"
      ]);

      return respostaJSON({
        actionResponse: { type: "UPDATE_MESSAGE" },
        cardsV2: [{
          cardId: "ok",
          card: {
            header: {
              title: "Salvo no Simulador MVP",
              subtitle: fornecedor + " | R$ " + valor.toFixed(2) + " | " + centroCusto
            }
          }
        }]
      });

    } catch (err) {
      return respostaJSON({ text: "Erro ao salvar na planilha: " + err.message });
    }
  }
}

function calcularOrcamento(texto) {
  var numeros = texto.match(/\d+(?:[.,]\d+)?/g);
  if (!numeros) {
    return respostaJSON({ text: "Informe o custo real. Ex: orcamento 500" });
  }

  var custoReal  = parseFloat(numeros[0].replace(",", "."));
  var margem     = 0.40;
  var imposto    = 0.00;
  var precoFinal = custoReal / (1 - imposto - margem);
  var lucro      = precoFinal - custoReal;

  return respostaJSON({
    text: "Orcamento Estruturado\n\n" +
          "Custo Base: R$ " + custoReal.toFixed(2) + "\n" +
          "Margem Liquida: 40%\n" +
          "Lucro Projetado: R$ " + lucro.toFixed(2) + "\n" +
          "Preco de Venda Final: R$ " + precoFinal.toFixed(2)
  });
}
